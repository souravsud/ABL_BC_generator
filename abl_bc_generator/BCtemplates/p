FoamFile
{
    version     {{ version }};
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

#include        "include/initialConditions"

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform $pressure;

boundaryField
{
    {{ patches.inlet }}
    {
        type            {{ bc_p.inlet.type }};
    }

    {{ patches.outlet }}
    {
        type            {{ bc_p.outlet.type }};
        {% if bc_p.outlet.value is defined and bc_p.outlet.value %}
        value           {{ bc_p.outlet.value }};
        {% endif %}
    }

    {{ patches.ground }}
    {
        type            {{ bc_p.ground.type }};
    }

    {{ patches.sky }}
    {
        type            {{ bc_p.sky.type }};
    }

    {{ patches.sides }}
    {
        type            {{ bc_p.sides.type }};
    }

    "proc.*"
    {
        type            processor;
    }
}

